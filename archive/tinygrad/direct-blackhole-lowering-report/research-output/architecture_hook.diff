+import unittest
+
+from tinygrad.tensor import Tensor
+from tinygrad.uop.ops import UOp
+from tinygrad.callify import transform_to_call
+from tinygrad.schedule import create_schedule, lower_sink_to_linear, schedule_cache
+from tinygrad.schedule.rangeify import get_kernel_graph
+from tinygrad.schedule.backend import BackendGraph, register_graph_lowerer, unregister_graph_lowerer
+
+
+class TestBackendGraphLowerer(unittest.TestCase):
+  def setUp(self):
+    self.registered: list[str] = []
+    schedule_cache.clear()
+
+  def tearDown(self):
+    for name in reversed(self.registered): unregister_graph_lowerer(name)
+    schedule_cache.clear()
+
+  def register(self, name, lowerer):
+    register_graph_lowerer(name, lowerer)
+    self.registered.append(name)
+
+  @staticmethod
+  def function():
+    x = Tensor.empty(8, device="PYTHON")
+    call, _ = transform_to_call(UOp.sink(((x + 1) * 2).uop))
+    return call.src[0]
+
+  def test_default_path_is_unchanged(self):
+    function = self.function()
+    expected = create_schedule(get_kernel_graph(function))
+    self.assertEqual(lower_sink_to_linear(function).key, expected.key)
+    self.assertIn(function.key, schedule_cache)
+
+  def test_lowerer_receives_full_function_and_materialization_roots(self):
+    function = self.function()
+    seen = []
+    def lower(request):
+      seen.append(request)
+      return BackendGraph(get_kernel_graph(request.function), b"mock-v1")
+    self.register("mock", lower)
+    expected = create_schedule(get_kernel_graph(function))
+    self.assertEqual(lower_sink_to_linear(function).key, expected.key)
+    self.assertEqual(seen[0].function, function)
+    self.assertEqual(seen[0].roots, function.src)
+    self.assertNotIn(function.key, schedule_cache)
+
+  def test_backend_cache_tag_separates_schedules(self):
+    function = self.function()
+    self.register("mock", lambda request: BackendGraph(get_kernel_graph(request.function), b"v1"))
+    lower_sink_to_linear(function)
+    first_keys = set(schedule_cache)
+    unregister_graph_lowerer(self.registered.pop())
+    self.register("mock", lambda request: BackendGraph(get_kernel_graph(request.function), b"v2"))
+    lower_sink_to_linear(function)
+    self.assertEqual(len(set(schedule_cache) - first_keys), 1)
+
+  def test_multiple_claimants_fail_deterministically(self):
+    function = self.function()
+    claim = lambda request: BackendGraph(get_kernel_graph(request.function), b"v1")
+    self.register("zeta", claim)
+    self.register("alpha", claim)
+    with self.assertRaisesRegex(RuntimeError, "alpha, zeta"):
+      lower_sink_to_linear(function)
+
+
+if __name__ == "__main__": unittest.main()
