+from dataclasses import dataclass
+from typing import Callable
+
+from tinygrad.uop.ops import UOp
+
+
+@dataclass(frozen=True)
+class GraphLoweringRequest:
+  """Renderer-neutral input to an optional backend graph lowerer."""
+  function: UOp
+  roots: tuple[UOp, ...]
+
+
+@dataclass(frozen=True)
+class BackendGraph:
+  """An ordinary Tinygrad call graph plus a backend-defined cache discriminator."""
+  graph: UOp
+  cache_tag: bytes
+
+
+GraphLowerer = Callable[[GraphLoweringRequest], BackendGraph | None]
+_graph_lowerers: dict[str, GraphLowerer] = {}
+
+
+def register_graph_lowerer(name: str, lowerer: GraphLowerer) -> None:
+  if not name or name in _graph_lowerers: raise ValueError(f"graph lowerer {name!r} is already registered or invalid")
+  _graph_lowerers[name] = lowerer
+
+
+def unregister_graph_lowerer(name: str) -> None:
+  del _graph_lowerers[name]
+
+
+def try_lower_graph(function: UOp) -> tuple[str, BackendGraph] | None:
+  request = GraphLoweringRequest(function, function.src)
+  matches: list[tuple[str, BackendGraph]] = []
+  for name in sorted(_graph_lowerers):
+    if (result := _graph_lowerers[name](request)) is not None:
+      if not isinstance(result.cache_tag, bytes) or not result.cache_tag:
+        raise ValueError(f"graph lowerer {name!r} must return a non-empty bytes cache_tag")
+      matches.append((name, result))
+  if len(matches) > 1:
+    raise RuntimeError(f"multiple backend graph lowerers claimed one function: {', '.join(name for name, _ in matches)}")
+  return matches[0] if matches else None
